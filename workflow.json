      "id": "04b04261-4fe0-433a-86d8-58d84fa459a5",
      "name": "Alle 5 Minuten",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "http://PAPERLESS_HOST:8010/api/documents/?tags__id__none=1&page_size=20&ordering=-id",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "6cee5c53-81ff-435d-8cee-36355515c41a",
      "name": "Unverarbeitete Belege holen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_CREDENTIAL_ID",
          "name": "Paperless API"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "results",
        "options": {}
      },
      "id": "84f5b208-2be5-4465-9146-c57832f0e07f",
      "name": "Belege einzeln",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const beleg = $json.content || '';\nconst prompt = 'Extrahiere aus dem folgenden Beleg die Felder supplier_name, bill_no, bill_date (YYYY-MM-DD), net, vat, total (Zahlen mit Punkt). Antworte ausschliesslich mit JSON.\\n\\nBeleg:\\n' + beleg;\nreturn { json: { doc_id: $json.id, ollamaBody: JSON.stringify({ model: 'qwen2.5:7b', stream: false, format: 'json', prompt: prompt }) } };"
      },
      "id": "a1c281cf-6e81-4265-a844-d38aaa93d5cb",
      "name": "Prompt bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://OLLAMA_HOST:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.ollamaBody }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "03c328ab-77ea-45af-96b9-b5a58e4fd702",
      "name": "Ollama Extraktion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = JSON.parse($json.response);\nconst doc = $('Prompt bauen').item.json.doc_id;\nreturn { json: { doc_id: doc, supplier_name: r.supplier_name, bill_no: r.bill_no, bill_date: r.bill_date, net: Number(r.net), total: Number(r.total) } };"
      },
      "id": "c982f13c-162d-44a0-a6b4-0bfda6b8081e",
      "name": "Felder lesen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ \"http://ERPNEXT_HOST:8090/api/resource/Supplier?filters=\" + encodeURIComponent(JSON.stringify([[\"supplier_name\",\"=\",$json.supplier_name]])) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b0e73994-6fee-443c-811d-f089ddd382b7",
      "name": "Lieferant in ERPNext suchen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1344,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_CREDENTIAL_ID",
          "name": "ERPNext API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data.length }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "405d51e3-ba2e-4926-84c0-eed9041bc19f",
      "name": "Lieferant vorhanden?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1568,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f = $('Felder lesen').item.json;\nconst body = { doctype: 'Purchase Invoice', company: 'DEMO_FIRMA', supplier: f.supplier_name, bill_no: f.bill_no, bill_date: f.bill_date, posting_date: f.bill_date, currency: 'EUR', items: [{ item_code: 'DEMO-LEISTUNG', qty: 1, rate: f.net, expense_account: '5130 - Einkauf Roh-, Hilfs- und Betriebsstoffe 19% Vorsteuer - S' }], taxes: [{ charge_type: 'On Net Total', account_head: '1406 - Abziehbare Vorsteuer 19 % - S', rate: 19, description: 'Vorsteuer 19 %' }] };\nreturn { json: { doc_id: f.doc_id, invoiceBody: JSON.stringify(body) } };"
      },
      "id": "b320fd42-7859-41cd-8ef2-245b62ee7d31",
      "name": "Eingangsrechnung bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ERPNEXT_HOST:8090/api/resource/Purchase%20Invoice",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.invoiceBody }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1
            }
          }
        }
      },
      "id": "ebff91b1-f0ef-4237-9502-fba34de52f30",
      "name": "ERPNext Entwurf anlegen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2016,
