    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const beleg = $json.content || '';\nconst prompt = 'Extrahiere aus dem folgenden Beleg die Felder supplier_name, bill_no, bill_date (YYYY-MM-DD), net, vat, total (Zahlen mit Punkt). Antworte ausschliesslich mit JSON.\\n\\nBeleg:\\n' + beleg;\nreturn { json: { doc_id: $json.id, ollamaBody: JSON.stringify({ model: 'qwen2.5:7b', stream: false, format: 'json', prompt: prompt }) } };"
      },
      "id": "a1c281cf-6e81-4265-a844-d38aaa93d5cb",
      "name": "Prompt bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://OLLAMA_HOST:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.ollamaBody }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "03c328ab-77ea-45af-96b9-b5a58e4fd702",
      "name": "Ollama Extraktion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const doc = $('Prompt bauen').item.json.doc_id;\nlet r;\ntry {\n  r = JSON.parse($json.response);\n} catch (e) {\n  return { json: { doc_id: doc, review_reason: 'KI-Auswertung fehlgeschlagen oder kein gültiges JSON' } };\n}\nif (!r || typeof r !== 'object') {\n  return { json: { doc_id: doc, review_reason: 'KI-Antwort ist leer' } };\n}\nconst net = Number(r.net);\nconst total = Number(r.total);\nconst fehler = [];\nif (!r.supplier_name) fehler.push('Lieferant fehlt');\nif (!r.bill_no) fehler.push('Rechnungsnummer fehlt');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(r.bill_date || '')) fehler.push('Datum fehlt oder ist ungültig');\nif (!(net > 0) || !(total >= net)) fehler.push('Beträge unplausibel');\nreturn { json: { doc_id: doc, supplier_name: r.supplier_name, bill_no: r.bill_no, bill_date: r.bill_date, net: net, total: total, review_reason: fehler.join(', ') } };"
      },
      "id": "c982f13c-162d-44a0-a6b4-0bfda6b8081e",
      "name": "Felder lesen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ \"http://ERPNEXT_HOST:8090/api/resource/Supplier?filters=\" + encodeURIComponent(JSON.stringify([[\"supplier_name\",\"=\",$json.supplier_name]])) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b0e73994-6fee-443c-811d-f089ddd382b7",
      "name": "Lieferant in ERPNext suchen",
