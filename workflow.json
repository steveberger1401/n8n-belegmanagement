      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_CREDENTIAL_ID",
          "name": "ERPNext API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://PAPERLESS_HOST:8010/api/documents/bulk_edit/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ documents: [$(\"Felder lesen\").item.json.doc_id], method: \"add_tag\", parameters: { tag: 1 } }) }}",
        "options": {}
      },
