        "url": "=http://PAPERLESS_HOST:8010/api/documents/{{ $json.doc_id }}/notes/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.noteBody }}",
